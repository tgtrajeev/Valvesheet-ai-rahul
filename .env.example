ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Provider: anthropic | gemini | openai | qwen | deepseek | glm
LLM_PROVIDER=anthropic

# ── Gemini (Google AI Studio) — RECOMMENDED Claude replacement ──
# Free key: https://aistudio.google.com/apikey
# gemini-2.5-flash = best value (~88% cheaper than Claude); gemini-2.5-pro = near-Claude quality
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (native) ──
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# ── Qwen (Alibaba DashScope) ──
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# ── DeepSeek ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── GLM / Zhipu AI (or Cerebras) ──
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# ── OpenRouter (gateway to 100+ models) ──
# Key: https://openrouter.ai/keys · Model slugs: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/valve_agent

# PMS Generator (Render) — read-only: pull approved classes from pms_cache when using Generate PMS / Push to Valvesheet AI
PMS_GENERATOR_DATABASE_URL=postgresql://user:password@pms-generator-host:5432/pms_generator

# Optional. If unset, push/sync reuses DATABASE_URL for valve_agent.public.pms_sheets (normal for one-DB setups).
# VALVE_AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/valve_agent
AGENT_MODEL=claude-sonnet-4-20250514
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOOL_CALLS=10
PORT=8001
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
