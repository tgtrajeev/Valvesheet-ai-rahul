ANTHROPIC_API_KEY=your-anthropic-api-key-here
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/valve_agent

# PMS Generator (Render) — read-only: pull approved classes from pms_cache when using Generate PMS / Push to Valvesheet AI
PMS_GENERATOR_DATABASE_URL=postgresql://user:password@pms-generator-host:5432/pms_generator

# Optional. If unset, push/sync reuses DATABASE_URL for valve_agent.public.pms_sheets (normal for one-DB setups).
# VALVE_AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/valve_agent
AGENT_MODEL=claude-sonnet-4-6

AGENT_TEMPERATURE=0.1
AGENT_MAX_TOOL_CALLS=10
PORT=8001
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
